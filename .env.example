# Client (Vite app). URL-ul API-ului de sincronizare (fără slash final).
# Local: serverul Express din server/index.js
VITE_SYNC_API_URL=http://localhost:3001
# Vercel (același domeniu): decomentează linia de mai jos și comentează cea de sus
# VITE_SYNC_API_URL=/

# Token Bearer opțional pentru autentificare. Trebuie să corespundă cu
# secretul AUTH_TOKEN setat pentru serverul de sincronizare.
# Lasă gol pentru dezactivare (doar local!).
VITE_SYNC_AUTH_TOKEN=

# Connection string PostgreSQL pentru serverul de sincronizare.
DATABASE_URL=postgresql://postgres:!yXZam%MjV7r&Ci@db.vfqduelvlmotnbscnbyx.supabase.co:5432/postgres

# Server de sincronizare local (server/index.js)
PORT=3001
