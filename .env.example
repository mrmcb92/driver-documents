# Client (Vite app). URL-ul API-ului de sincronizare (fără slash final).
# Local: serverul de referință din server/index.js
# VITE_SYNC_API_URL=http://localhost:3001
# Supabase: URL-ul Edge Function-ului "sync" (vezi README - deploy din Dashboard)
VITE_SYNC_API_URL=https://<project-ref>.supabase.co/functions/v1/sync

# Token Bearer opțional pentru autentificare. Trebuie să corespundă cu
# secret-ul SYNC_API_KEY setat în Dashboard (Edge Functions → Secrets).
# Lasă gol pentru dezactivare (doar local!).
VITE_SYNC_AUTH_TOKEN=

# Supabase direct client config
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# Server de sincronizare local (server/index.js)
PORT=3001
AUTH_TOKEN=
