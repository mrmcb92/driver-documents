# Client (Vite app). URL-ul API-ului de sincronizare (fără slash final).
# Exemplu pentru serverul local de referință:
VITE_SYNC_API_URL=http://localhost:3001

# Server de sincronizare (server/index.js)
PORT=3001

# Token Bearer opțional pentru autentificare. Lasă gol pentru dezactivare (doar local!).
AUTH_TOKEN=
